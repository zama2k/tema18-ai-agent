# Keep the Docker build contexts small and free of secrets. The images only need requirements.txt,
# VERSION, src/ (agent image) and deploy/ (simulated host image).
.git
.gitattributes
.github
.venv
venv
.env
.env.*
__pycache__
*.py[cod]
.pytest_cache
.mypy_cache
.ruff_cache
.coverage
coverage.xml
htmlcov
evidencias
evals/reports
tests
docs
monitoring/secrets
monitoring/.tmp
deploy/.tmp
