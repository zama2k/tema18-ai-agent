[Unit]
Description=AI agent (blue slot)
After=network.target

[Service]
User=deploy
WorkingDirectory=/opt/agent/slots/blue
EnvironmentFile=/etc/agent/agent.env
EnvironmentFile=/opt/agent/slots/blue.env
ExecStart=/opt/agent/slots/blue/.venv/bin/python -m uvicorn src.api:create_app --factory --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
