[Unit]
Description=AI agent (green slot)
After=network.target

[Service]
User=deploy
WorkingDirectory=/opt/agent/slots/green
EnvironmentFile=/etc/agent/agent.env
EnvironmentFile=/opt/agent/slots/green.env
ExecStart=/opt/agent/slots/green/.venv/bin/python -m uvicorn src.api:create_app --factory --host 127.0.0.1 --port 8001
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
